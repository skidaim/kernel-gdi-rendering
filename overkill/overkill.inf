;
; overkill.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = overkill.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
overkill.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%overkill.DeviceDesc% = overkill_Device, Root\overkill ; TODO: edit hw-id

[overkill_Device.NT]
CopyFiles = File_Copy

[File_Copy]
overkill.sys

;-------------- Service installation
[overkill_Device.NT.Services]
AddService = overkill,%SPSVCINST_ASSOCSERVICE%, overkill_Service_Inst

; -------------- overkill driver install sections
[overkill_Service_Inst]
DisplayName    = %overkill.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\overkill.sys

[overkill_Device.NT.Wdf]
KmdfService = overkill, overkill_wdfsect

[overkill_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "overkill Installation Disk"
overkill.DeviceDesc = "overkill Device"
overkill.SVCDESC = "overkill Service"
